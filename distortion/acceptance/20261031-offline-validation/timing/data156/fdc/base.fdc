# Standalone diagnostic only. No DDR ports or shared constraint changes.
# Inherits physical attributes, NOT external IO/CDC timing acceptance.
# No fabricated IO delays, pullups or blanket false paths.
create_clock -name board27 -period 37.037037 [get_ports clk_27m]
create_clock -name input_pixel -period 13.315579 [get_ports pixclk_in]
create_generated_clock -name pixel_clk -source [get_ports clk_27m] -multiply_by 11 -divide_by 4 [get_pins video_pll/clkout0]
create_generated_clock -name cfg_clk -source [get_ports clk_27m] -multiply_by 10 -divide_by 27 [get_pins configuration_pll/clkout0]
