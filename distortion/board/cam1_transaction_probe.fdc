create_clock -name clk_27m -period 37.037 [get_ports clk_27m]
set_false_path -from [get_ports {cam_rst_n cam_scl cam_sda}] -to [get_clocks clk_27m]
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:clk_27m} {PAP_IO_VCCIO} {3.3}
