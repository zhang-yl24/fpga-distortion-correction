set_max_skew 6.0 -from [get_cells -hierarchical -regexp {^capture_size/(wr_gray\[(6:0|[0-6])\]|wr_binary\[6\])$}] -to [get_cells -hierarchical -regexp {^capture_size/wr_gray_r1\[(6:0|[0-6])\]$}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {^display_size/(rd_gray\[(9:0|[0-9])\]|rd_binary\[9\])$}] -to [get_cells -hierarchical -regexp {^display_size/rd_gray_w1\[(9:0|[0-9])\]$}]
set_max_skew 6.0 -from [get_cells -hierarchical -regexp {^display_size/(rd_gray\[(9:0|[0-9])\]|rd_binary\[9\])$}] -to [get_cells -hierarchical -regexp {^display_size/rd_gray_w1\[(9:0|[0-9])\]$}]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {^display_size/(wr_gray\[(9:0|[0-9])\]|wr_binary\[9\])$}] -to [get_cells -hierarchical -regexp {^display_size/wr_gray_r1\[(9:0|[0-9])\]$}]
