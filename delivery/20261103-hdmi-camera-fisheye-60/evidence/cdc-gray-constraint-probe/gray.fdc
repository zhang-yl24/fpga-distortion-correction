create_clock -name wr_clk -period 8 [get_ports wr_clk]
create_clock -name rd_clk -period 6.6667 [get_ports rd_clk]
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {^capture_size/(rd_gray\[(6:0|[0-6])\]|rd_binary\[6\])$}] -to [get_cells -hierarchical -regexp {^capture_size/rd_gray_w1\[(6:0|[0-6])\]$}]
set_max_skew 6.0 -from [get_cells -hierarchical -regexp {^capture_size/(rd_gray\[(6:0|[0-6])\]|rd_binary\[6\])$}] -to [get_cells -hierarchical -regexp {^capture_size/rd_gray_w1\[(6:0|[0-6])\]$}]
