set_max_skew 6.0 -from [get_cells -hierarchical -regexp {^system/display_fifo/(rd_gray\[(9:0|[0-9])\]|rd_binary\[9\])$}] -to [get_cells -hierarchical -regexp {^system/display_fifo/rd_gray_w1\[(9:0|[0-9])\]$}]
