# Gray pointer CDC candidate. PDS 2025.2 verified syntax.
# Four exact source-register groups to first synchronizer stage only.
# Includes pre-synthesis vector names, bit names and binary-MSB aliases.
# Max delay includes source tco and destination setup in PDS reports.
# Rebuild and run verify_gray_constraints.py; final H closure is required.
set_max_delay 6.0 -datapath_only -from [get_cells -hierarchical -regexp {^system/input_link/input_dma/capture/pixels/(rd_gray\[(6:0|[0-6])\]|rd_binary\[6\])$}] -to [get_cells -hierarchical -regexp {^system/input_link/input_dma/capture/pixels/rd_gray_w1\[(6:0|[0-6])\]$}]
set_max_skew 6.0 -from [get_cells -hierarchical -regexp {^system/input_link/input_dma/capture/pixels/(rd_gray\[(6:0|[0-6])\]|rd_binary\[6\])$}] -to [get_cells -hierarchical -regexp {^system/input_link/input_dma/capture/pixels/rd_gray_w1\[(6:0|[0-6])\]$}]
