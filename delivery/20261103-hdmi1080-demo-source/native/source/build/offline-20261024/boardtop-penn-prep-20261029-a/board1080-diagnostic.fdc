# DIAGNOSTIC ONLY: external IO delay constraints intentionally absent. No physical acceptance.
# Actual BASE V1.4 versus local PCB V1.2: trace skew is UNVERIFIED.
# Existing cross-clock 8ns/max and0ns/min are diagnostic bounds, not CDC/skew/hold signoff.
# board1080 DEVELOPMENT constraints. NOT a physical timing sign-off.
#142 independent pins; no camera/UART/old130-pin expectation.
# HDMI I/O AC delays below are PROVISIONAL half-period engineering budgets,
# NOT values from MS7200/MS7210 AC specifications. PhysicalTimingReady=false.
# No blanket clock groups/false paths hide the new CDC boundaries.
create_clock -name board27 -period 37.037037 [get_ports clk_27m]
#75.1MHz STA envelope covers the digital<=75MHz activity window plus sampling margin.
create_clock -name input_pixel -period 13.315579 [get_ports pixclk_in]
create_generated_clock -name pixel_clk -source [get_ports clk_27m] -multiply_by 11 -divide_by 4 [get_pins video_pll/clkout0]
create_generated_clock -name cfg_clk -source [get_ports clk_27m] -multiply_by 10 -divide_by 27 [get_pins configuration_pll/clkout0]

# PROVISIONAL: source sampling is the reference rising PCLK edge only.
# Missing: configured PCLK inversion/SDR choice, RX tCO(min/max), TX setup/hold, trace skew.

# Exact reference physical pad/electrical attributes; not a new routing proof.
