# HMIC_S 1.10 / PG2L100H FBG676 -6: restore only the IP-owned
# rst_clk and phy_dq_clk asynchronous clock relations from the generated
# example pnr/ddr_test.fdc lines 21-23. Load AFTER the DDR clock definitions.
# Exact reference and current IDF (371 parameters), wrapper, PHY top,
# reset synchronizer, reset controller and slice top SHA256 match.
# Provenance and scope: DDR_RESET_CONSTRAINT_AUDIT.md,
# ip_reference_comparison.json, clock_endpoint_ownership.json.
#
# PDS 2025 UG990202 section 3.5.4.16: a single -group is asynchronous
# to all other clocks, including generated descendants. These IP groups
# therefore intentionally separate the fast PHY and divided PHY clocks.
# This restores the vendor timing model; it is not a board stability test.
#
# Original reference groups free_clk/ref_clk are NOT copied: user domain
# relations retain the diagnostic 8 ns max / 0 ns min constraints.
# No group is created for ddrphy_sysclk or phy_dq_sysclk_0/1. Their true
# data paths retain the existing multicycle=2 and 0.4 ns uncertainty.
# All leaf clocks of the following three domains must remain owned by
# u_ddr3_test_h. Re-run audit_clock_ownership.py on every final route.

set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
