localparam signed [31:0] FISHEYE_OUT_CX=32'sh00037f7a;
localparam signed [31:0] FISHEYE_OUT_CY=32'sh0002311e;
localparam signed [31:0] FISHEYE_SRC_CX=32'sh0003afbf;
localparam signed [31:0] FISHEYE_SRC_CY=32'sh00022c90;
localparam signed [31:0] FISHEYE_SRC_FX=32'sh0003283a;
localparam signed [31:0] FISHEYE_SRC_FY=32'sh00032a15;
localparam signed [31:0] FISHEYE_INV_FX=32'sh0020dd73;
localparam signed [31:0] FISHEYE_INV_FY=32'sh0020ca34;
localparam integer FISHEYE_R2_MAX_Q22=33554432;
localparam integer FISHEYE_RADIAL_SEGMENTS=1024;
